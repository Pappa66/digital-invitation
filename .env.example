# ============================================================
# Digital Invitation Builder — Environment Variables
# Salin file ini menjadi .env.local untuk pengembangan lokal.
# Di Vercel, isi lewat Project Settings > Environment Variables.
# JANGAN pernah commit .env.local ke GitHub.
# ============================================================

# --- Supabase -------------------------------------------------
# URL proyek Supabase (Settings > API > Project URL).
NEXT_PUBLIC_SUPABASE_URL=https://ktfirkidyebbpijqwdgt.supabase.co

# Supabase Anon/Public key (Settings > API > Project API keys > anon public).
# AMAN untuk publik, jangan gunakan service_role di sini.
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Imt0Zmlya2lkeWViYnBpanF3ZGd0Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODY2OTk0ODYsImV4cCI6MjEwMjI3NTQ4Nn0.kTutlFzIAzFI03E2tEJ8to7ZMT8OdHZ57cd-LFGtMFo

# --- Mode Demo -------------------------------------------------
# Saat 'true', aplikasi berjalan tanpa Supabase (data di localStorage browser)
# dan halaman login/middleware tidak membutuhkan autentikasi.
# Mode PRODUKSI: set ke 'false' di Vercel.
NEXT_PUBLIC_DEMO_MODE=false

# --- Google OAuth (Supabase Auth) ------------------------------
# Di Supabase: Authentication > Providers > Google > Enable.
# OAuth Client ID & Secret diambil dari Google Cloud Console
# (Credentials > OAuth 2.0 Client IDs).
# Authorized redirect URIs di Google:  https://<domain>/auth/callback
# Redirect URLs di Supabase:           https://<domain>/auth/callback
# Tidak perlu env tambahan: Google OAuth dikelola oleh Supabase.

# --- Supabase CLI ----------------------------------------------
# Aplikasikan migrasi SQL ke project:
#   supabase login
#   supabase init
#   supabase link --project-ref ktfirkidyebbpijqwdgt
#   supabase db push
# Atau jalankan supabase/apply_all.sql (gabungan 0001 + 0002)
# melalui Supabase Dashboard > SQL Editor (satu kali RUN).

# --- Email yang diizinkan masuk internal -----------------------
# HARDCODE di src/lib/auth-allowed.ts (ALLOWED_EMAIL).
# Terapkan nilai yang sama di konstanta tersebut.

# --- Vercel -----------------------------------------------------
# Tidak ada env khusus. Framework terdeteksi otomatis (Next.js).
#  1. Set 3 var di atas (URL & ANON KEY di atas, DEMO_MODE='false' saat
#     tabel + Google OAuth sudah siap).
#  2. Jalankan migration SQL via SQL Editor.
#  3. Production domain: tambahkan ke Authorized Redirect di Google
#     dan Redirect URLs di Supabase Auth.
